{
  "Routes": [
    {
      "Key": "user-profile-self-read",
      "Priority": 10,
      "UpstreamPathTemplate": "/user-profiles/me",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "DownstreamPathTemplate": "/api/user-profiles/{userId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 5194
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKeys": [
          "Bearer"
        ],
        "AllowedScopes": [
          "profile.read"
        ]
      },
      "RouteClaimsRequirement": {
        "role": "member"
      },
      "ChangeDownstreamPathTemplate": {
        "userId": "Claims[sub] > value"
      },
      "AddHeadersToRequest": {
        "X-UserId": "Claims[sub] > value",
        "X-Role": "Claims[role] > value"
      }
    },
    {
